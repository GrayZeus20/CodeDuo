# CodeDuo — Apache Configuration for Laragon
DirectoryIndex index.php index.html

# Prevent directory browsing
Options -Indexes

# If index.php exists, it handles redirecting root visitors to dist/
<IfModule mod_rewrite.c>
    RewriteEngine On
    # Do not rewrite if accessing dist or api or existing files
    RewriteCond %{REQUEST_URI} ^/CodeDuo/?$ [NC]
    RewriteRule ^$ index.php [L]
    # 2026-10-17 security (audit wave 2): deny dotfile (.env/.git/config) + dot-dir.
    RewriteRule "(^|/)\.(?!well-known)" - [F]
</IfModule>

<IfModule mod_authz_core.c>
    <FilesMatch "^\.">
        Require all denied
    </FilesMatch>
</IfModule>

# Cache: service worker & HTML jangan pernah tertahan (biar update PWA langsung terpakai).
# Aset Vite ber-hash (index-CPteohrP.js) boleh immutable.
<IfModule mod_headers.c>
    <FilesMatch "^(sw\.js|manifest\.json|index\.html|styles\.css)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>
    <FilesMatch "-[A-Za-z0-9_-]{8,}\.(js|css|png|svg|woff2?)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
