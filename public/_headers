# Cloudflare Pages / Netlify headers.
# Service worker & HTML tidak boleh tertahan cache browser → update langsung terpakai.
# (File ini otomatis ikut ter-copy ke dist/ oleh Vite karena ada di public/.)

/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

/index.html
  Cache-Control: no-cache, must-revalidate

/
  Cache-Control: no-cache, must-revalidate

/manifest.json
  Cache-Control: no-cache, must-revalidate

/styles.css
  Cache-Control: no-cache, must-revalidate

# Aset Vite ber-hash: nama berubah tiap build → aman di-cache selamanya.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
